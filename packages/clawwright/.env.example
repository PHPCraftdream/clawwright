# Deployment configuration template.
# `new-app` and `init` copy this into the deployment; `./clawwright bootstrap` fills in the
# generated gateway token. The copy is git-ignored: it holds a secret and host paths.
#
# OC_* variables belong to this tooling. OPENCLAW_* variables are OpenClaw's own and are
# passed into the container as-is.

# Published image. `extended-stable` is the conservative trailing-month channel.
# For a production server pin an immutable release tag instead, e.g.:
#   OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.2.26
# Variants: :slim (smaller), :latest-browser (Chromium preinstalled for the browser tool).
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:extended-stable

# Where the target machine actually is, relative to this tooling — nothing below assumes
# WSL specifically; the transport is picked from this alone.
#   auto   (default) Windows tooling -> the WSL2 distro below; anywhere else -> local
#   local  tooling and target share a filesystem (native Linux, or already inside WSL)
#   wsl    tooling on Windows, target is a WSL2 distribution — the common local dev setup
#   ssh    target is a remote Linux host reached over SSH (a remote Docker host included —
#          this is that mode, not a separate one)
OC_TARGET_LOCATION=auto
# Only read when OC_TARGET_LOCATION is wsl (or auto picks wsl on Windows).
OC_WSL_DISTRO=Ubuntu-24.04
# user@host — required when OC_TARGET_LOCATION=ssh.
OC_SSH_HOST=
# Where this repository's checkout lives on the target when deploying over SSH (./clawwright
# deploy); irrelevant otherwise.
OC_REMOTE_PATH=/opt/openclaw

# Docker Compose project name, when it must differ from this deployment's own directory
# name. Usually unset: the directory name is used as-is. Set this to adopt an instance that
# already exists under a name this deployment's own directory cannot have — Docker Compose
# accepts underscores in a project name, this tooling's deployment names do not (they also
# become filesystem paths). Leave blank to use the directory name.
OC_COMPOSE_PROJECT=

# Host directory holding all persistent state. Created by `./clawwright bootstrap` with owner
# 1000:1000 (the `node` user inside the image). Subdirectories: config/, workspace/,
# auth-secrets/.
OC_DATA_DIR=/srv/openclaw/data

# Address the gateway port is published on.
# 127.0.0.1 = reachable only from this host; use an SSH tunnel for remote access.
# Set to 0.0.0.0 ONLY behind a reverse proxy with TLS and authentication.
OC_BIND_ADDRESS=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789

# OpenClaw security audit blocking threshold: critical (default) or warn.
OC_AUDIT_BLOCK=critical

# Gateway auth token. Generated by `./clawwright bootstrap`; keep it secret.
OPENCLAW_GATEWAY_TOKEN=

# Container timezone.
OPENCLAW_TZ=UTC

# Where `./clawwright backup` writes archives.
OC_BACKUP_DIR=/srv/openclaw/backups

# Where `./clawwright pull` stores snapshots taken from the instance.
# Deliberately NOT inside the repository: a snapshot holds the gateway token, provider API
# keys and the agent's whole history, and on a Windows-mounted path (/mnt/...) chmod is
# silently ignored — the file would stay world-readable.
OC_SNAPSHOT_DIR=/srv/openclaw/snapshots
# How many archives to keep (older ones are deleted after a new backup). Pairs with
# `./clawwright backup install` for the schedule that actually produces those backups.
OC_BACKUP_KEEP=10
# How many snapshots to keep (older ones, and their .template.env/.secrets.env sidecar
# files, are deleted after a new pull). Separate from OC_BACKUP_KEEP: a pull run on a
# schedule (smoke, a cron) would otherwise fill the snapshot directory without bound.
OC_SNAPSHOT_KEEP=10
# Both: 0 disables rotation explicitly (logged, not silent); anything that is not a
# non-negative integer is a warning and falls back to 10, never a silent rotation-off.

# `./clawwright doctor`/`inspect`'s BACKUP_STALE threshold: how old the newest full backup
# archive may be before it is reported (warning, never blocking). A duration like 2d/36h/90m.
# 0 or off disables the finding entirely; anything else that does not parse is a warning and
# falls back to the default below.
#OC_BACKUP_MAX_AGE=2d

# Alert target for `./clawwright watch check`: POSTed only on a state transition (ok/degraded/
# down), never on every cycle. https, or http only against localhost/127.0.0.1. A secret —
# keep it out of anywhere this file itself might be shared.
#OC_WATCH_WEBHOOK=https://hooks.example/xxxxxxxx

# Payload shape for OC_WATCH_WEBHOOK: generic (default JSON envelope), slack, discord or
# telegram. Unset autodetects from the URL host (hooks.slack.com, discord.com/discordapp.com
# with /api/webhooks/, api.telegram.org) — set this only when autodetection would be wrong.
#OC_WATCH_WEBHOOK_FORMAT=slack

# Required when OC_WATCH_WEBHOOK_FORMAT is (or autodetects to) telegram: the chat sendMessage
# should post to. OC_WATCH_WEBHOOK itself is the full sendMessage URL in that case, e.g.
# https://api.telegram.org/bot<token>/sendMessage.
#OC_WATCH_TELEGRAM_CHAT_ID=

# `./clawwright watch check`'s free-space floor for the data directory, in MB. Below it:
# degraded. Below 10% of it or 100 MB (whichever is higher): down. Default 1024.
#OC_WATCH_DISK_MIN_MB=1024

# `./clawwright doctor`/`inspect`'s DISK_LOW threshold, in MB — separate from
# OC_WATCH_DISK_MIN_MB above: this one is a warning only, checked against the data directory
# AND the backup directory. 0 disables the finding; anything else that is not a non-negative
# integer is a warning and falls back to the default below.
#OC_DISK_MIN_FREE_MB=1024

# Dead-man's switch: a plain GET on every cycle where the state reads ok — never on
# degraded/down. https, or http only against localhost/127.0.0.1. A secret, like
# OC_WATCH_WEBHOOK. Works with healthchecks.io, Uptime Kuma's push monitor and Better
# Stack's heartbeat monitor — paste that service's own ping/push URL here; it alerts on its
# own once pings stop, which is how this catches the whole server going down, not just the
# instance. A failed ping is a warning only (see `watch status`), never a level change.
#OC_WATCH_HEARTBEAT_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
