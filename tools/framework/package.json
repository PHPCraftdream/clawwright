{
  "name": "@phpcraftdream/clawwright",
  "version": "0.1.2",
  "description": "Clawwright framework and CLI for operating self-hosted OpenClaw deployments.",
  "keywords": [
    "clawwright",
    "openclaw",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "ai-agents",
    "docker",
    "docker-compose",
    "self-hosting",
    "wsl2",
    "devops",
    "cli"
  ],
  "author": "PHPCraftdream (https://github.com/PHPCraftdream)",
  "license": "(MIT OR Apache-2.0)",
  "homepage": "https://github.com/PHPCraftdream/clawwright#readme",
  "bugs": {
    "url": "https://github.com/PHPCraftdream/clawwright/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PHPCraftdream/clawwright.git",
    "directory": "tools/framework"
  },
  "type": "module",
  "imports": {
    "#src/*": "./*"
  },
  "bin": {
    "clawwright": "dist/entry/bin.js"
  },
  "exports": {
    "./app": {
      "types": "./dist/core/app.d.ts",
      "default": "./dist/core/app.js"
    },
    "./mounts": {
      "types": "./dist/runtime/mounts.d.ts",
      "default": "./dist/runtime/mounts.js"
    },
    "./commands": {
      "types": "./dist/commands/interface/index.d.ts",
      "default": "./dist/commands/interface/index.js"
    },
    "./recipe-kit": {
      "types": "./dist/recipe-kit/index.d.ts",
      "default": "./dist/recipe-kit/index.js"
    },
    "./private-config": {
      "types": "./dist/security/privacy/private-config.d.ts",
      "default": "./dist/security/privacy/private-config.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepack": "node --experimental-strip-types ../build-framework-package.ts"
  },
  "dependencies": {
    "json5": "^2.2.3"
  },
  "ssjackRuntime": {
    "requirements": {
      "optional": true,
      "protocol": 1,
      "chunkSize": 16384,
      "capabilities": ["exec", "stdin", "binary", "backpressure", "cancel"],
      "cancellation": "connection-only"
    },
    "supply": {
      "kind": "ci",
      "repository": "PHPCraftdream/ssjack",
      "commit": "032b6730209d58ddb21d7066a5b7001391295df0",
      "platform": "linux-amd64",
      "runId": 40342299627,
      "artifactId": 12659098663,
      "artifactName": "verified-cli-Linux-X64",
      "archiveSHA256": "7d622fd539d426b8b597e03aceb836806686c2bf7eca5bb71b0b8af642b6d854",
      "executableSHA256": "7ca7398bf7ddbe6bce0a663b91f6a1e19579a8ae78b02e54fc3bdcc1519aae8f"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
