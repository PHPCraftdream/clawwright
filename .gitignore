# Secrets and host-specific configuration.
.env
*.token

# Deployments. An application is host-specific configuration — data directory, port,
# keys, snapshots, recipes — so it stays out of the repository entirely. Create one with
# ./clawwright new-app <name>; the framework supplies all the logic. Anchored to the repo
# root (leading /) — unanchored, this also matched tools/checks/integration/apps/, silently
# hiding any new file added there from `git add`.
/apps/

# Generated MCP client config (contains host paths).
.mcp.json

# Secret values per target. The template (config/secrets.template.env) is committed;
# the filled-in files never are.
secrets/

# Local data, backups and state snapshots must never enter the repository.
# Snapshots contain the gateway token, provider API keys and the agent's whole history.
data/
backups/
snapshots/
*.tar.gz
*.tar.zst
# Check-runner timing samples (local, per-host; rewritten every run).
/.check-timings.json

# npm packaging build output (tools/framework/ as an installable dependency) — generated by
# the pack build script, not authored; regenerated on demand, never the source of truth.
tools/framework/dist/
tools/framework/*.tgz
node_modules/

# Assistant/session scratch state.
.claude/

# Editor / OS noise.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db


# /wrush task worktrees — always created here, in-tree
/worktrees/
/.rush/
