{
  "name": "clawwright-repository",
  "version": "0.1.2",
  "private": true,
  "description": "Development repository for the @phpcraftdream/clawwright package.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "imports": {
    "#framework/*": "./tools/framework/*",
    "#checks/*": "./tools/checks/*",
    "#tools/*": "./tools/*"
  },
  "scripts": {
    "check": "node --experimental-strip-types tools/clawwright.ts check",
    "check:fast": "npm run typecheck && npm run lint && node --experimental-strip-types tools/clawwright.ts check --related",
    "check:controls": "node --experimental-strip-types tools/checks/controls/run-controls.ts",
    "golden:update": "node --experimental-strip-types tools/dev/golden-update.ts",
    "docs:commands": "node --experimental-strip-types tools/dev/docs-commands.ts",
    "check:linux": "node --experimental-strip-types tools/dev/check-linux.ts",
    "worktree": "node --experimental-strip-types tools/dev/worktree.ts",
    "test": "npm run check",
    "gate": "npm run typecheck && npm run lint && npm run check && npm run check:controls",
    "build": "node --experimental-strip-types tools/build-framework-package.ts",
    "install:system": "node --experimental-strip-types tools/dev/install-system.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint tools --deny-warnings",
    "format:check": "npm run typecheck && npm run lint",
    "pack:check": "cd tools/framework && npm pack --dry-run --json",
    "license:audit": "node --experimental-strip-types tools/checks/release/license-audit.ts && node --experimental-strip-types tools/checks/release/license-audit.check.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "1.74.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "json5": "^2.2.3"
  }
}
